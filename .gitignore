# =============================================================================
# Git Ignore Configuration for NanoRISC-V-C2 Project
# =============================================================================

# Byte-compiled / Python cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Simulation waveform dumps (can be re-generated with testbenches)
*.vcd
*.vpd
*.fsdb
*.wlf

# EDA compiled binaries and simulation outputs
*.vvp
*.o
*.obj
obj_dir/
work/
transcript
vsim.wlf

# Synthesis and CAD tool temporary files
reports/
*.syn
*.svf
*.log

# OS-specific temporary files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# Node / Web / Package manager files (if any tools are added)
node_modules/
.npm
.cache
.env
.env.*
!.env.example
